TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:8000/v1
TRADINGAGENTS_LLM_MODEL=my-model
OPENAI_COMPATIBLE_API_KEY=your_key_if_needed
TRADINGAGENTS_LLM_MAX_RETRIES=5

PORTFOLIO_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL
PORTFOLIO_CASH_BUDGET=500
PORTFOLIO_MAX_POSITIONS=3
PORTFOLIO_BUY_AMOUNT=75
# Cap on cost basis per symbol, so a held name is not topped up every cycle
PORTFOLIO_MAX_SYMBOL_COST=150
PORTFOLIO_RETRY_ATTEMPTS=3

# Full agent re-analysis, anchored after the US close so the last daily bar is final
PORTFOLIO_DECISION_AT=16:30
PORTFOLIO_DECISION_TZ=America/New_York
# Price/P&L refresh only, no LLM calls
PORTFOLIO_MARK_INTERVAL_HOURS=3

PORTFOLIO_HOST=127.0.0.1
PORTFOLIO_PORT=8765
